                  "pm.test(\"PB-API-021 matches the Account schema\", () => pm.response.to.have.jsonSchema(accountSchema));",
                  "pm.test(\"PB-API-021 returns the requested account\", () => {",
                  "  pm.expect(pm.response.json().id).to.eql(Number(pm.environment.get(\"fromAccountId\")));",
                  "});"
                ]
