          "name": "Create savings account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const accountSchema = {",
                  "  type: \"object\",",
                  "  required: [\"id\", \"customerId\", \"type\", \"balance\"],",
                  "  properties: {",
                  "    id: { type: \"integer\" },",
                  "    customerId: { type: \"integer\" },",
                  "    type: { type: \"string\", enum: [\"CHECKING\", \"SAVINGS\", \"LOAN\"] },",
                  "    balance: { type: \"number\" }",
