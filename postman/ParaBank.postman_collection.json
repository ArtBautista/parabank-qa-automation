  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Login - valid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"PB-API-001 status is 200\", () => pm.response.to.have.status(200));",
                  "const customer = pm.response.json();",
                  "pm.test(\"PB-API-001 returns the customer id and name\", () => {",
                  "  pm.expect(customer.id).to.be.a(\"number\");",
                  "  pm.expect(customer.firstName).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.test(\"PB-API-001 responds in under 2 s\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "pm.environment.set(\"customerId\", customer.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login/{{username}}/{{password}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login",
                "{{username}}",
                "{{password}}"
              ]
            },
            "description": "Logs in and saves customerId for every later request."
          }
        },
        {
          "name": "Login - wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"PB-API-002 wrong password is rejected with a 4xx\", () => {",
                  "  pm.expect(pm.response.code).to.be.within(400, 499);",
                  "});",
                  "pm.test(\"PB-API-002 no customer data is returned\", () => {",
                  "  pm.expect(pm.response.text()).to.not.include(\"firstName\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login/{{username}}/wrong-password-123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login",
                "{{username}}",
                "wrong-password-123"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "02 Customer",
      "item": [
        {
          "name": "Get customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"PB-API-010 status is 200\", () => pm.response.to.have.status(200));",
                  "const schema = {",
                  "  type: \"object\",",
                  "  required: [\"id\", \"firstName\", \"lastName\", \"address\", \"phoneNumber\"],",
                  "  properties: {",
                  "    id: { type: \"integer\" },",
                  "    firstName: { type: \"string\" },",
                  "    lastName: { type: \"string\" },",
                  "    address: { type: \"object\", required: [\"street\", \"city\", \"state\", \"zipCode\"] },",
                  "    phoneNumber: { type: \"string\" }",
                  "  }",
                  "};",
                  "pm.test(\"PB-API-010 matches the Customer schema\", () => pm.response.to.have.jsonSchema(schema));",
                  "pm.test(\"PB-API-010 id matches the logged-in customer\", () => {",
                  "  pm.expect(pm.response.json().id).to.eql(Number(pm.environment.get(\"customerId\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Get unknown customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"PB-API-011 unknown customer returns 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"PB-API-011 error names the missing customer\", () => {",
                  "  pm.expect(pm.response.text()).to.include(\"Could not find customer #999999999\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
