        {
          "name": "Transfer funds",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Data-driven runs pass transferAmount from postman/transfer-data.csv.",
                  "const amount = pm.iterationData.get(\"transferAmount\") || pm.environment.get(\"transferAmount\") || \"10\";",
                  "pm.environment.set(\"transferAmount\", amount);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"PB-API-031 transfer returns 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"PB-API-031 confirmation mentions both accounts\", () => {",
                  "  const text = pm.response.text();",
                  "  pm.expect(text).to.include(pm.environment.get(\"fromAccountId\"));",
                  "  pm.expect(text).to.include(pm.environment.get(\"toAccountId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transfer?fromAccountId={{fromAccountId}}&toAccountId={{toAccountId}}&amount={{transferAmount}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfer"
              ],
              "query": [
                {
                  "key": "fromAccountId",
                  "value": "{{fromAccountId}}"
                },
                {
                  "key": "toAccountId",
                  "value": "{{toAccountId}}"
                },
                {
                  "key": "amount",
                  "value": "{{transferAmount}}"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Balance after transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const before = Number(pm.environment.get(\"balanceBefore\"));",
                  "const amount = Number(pm.environment.get(\"transferAmount\"));",
                  "const after = pm.response.json().balance;",
                  "pm.test(\"PB-API-032 balance dropped by exactly the transferred amount\", () => {",
                  "  pm.expect(Math.round(after * 100)).to.eql(Math.round((before - amount) * 100));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{fromAccountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{fromAccountId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Transactions include the transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"PB-API-033 status is 200\", () => pm.response.to.have.status(200));",
                  "const amount = Number(pm.environment.get(\"transferAmount\"));",
                  "const transactions = pm.response.json();",
                  "pm.test(\"PB-API-033 a debit for the transferred amount exists\", () => {",
                  "  const found = transactions.some(t => t.type === \"Debit\" && Math.round(t.amount * 100) === Math.round(amount * 100));",
                  "  pm.expect(found).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
