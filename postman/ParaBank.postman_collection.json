    {
      "name": "03 Accounts",
      "item": [
        {
          "name": "Get customer accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const accountSchema = {",
                  "  type: \"object\",",
                  "  required: [\"id\", \"customerId\", \"type\", \"balance\"],",
                  "  properties: {",
                  "    id: { type: \"integer\" },",
                  "    customerId: { type: \"integer\" },",
                  "    type: { type: \"string\", enum: [\"CHECKING\", \"SAVINGS\", \"LOAN\"] },",
                  "    balance: { type: \"number\" }",
                  "  }",
                  "};",
                  "pm.test(\"PB-API-020 status is 200\", () => pm.response.to.have.status(200));",
                  "const accounts = pm.response.json();",
                  "pm.test(\"PB-API-020 customer has at least two accounts\", () => {",
                  "  pm.expect(accounts).to.be.an(\"array\").with.lengthOf.at.least(2);",
                  "});",
                  "pm.test(\"PB-API-020 every account matches the Account schema\", () => {",
                  "  pm.response.to.have.jsonSchema({ type: \"array\", items: accountSchema });",
                  "});",
                  "pm.test(\"PB-API-020 every account belongs to this customer\", () => {",
                  "  const id = Number(pm.environment.get(\"customerId\"));",
                  "  accounts.forEach(a => pm.expect(a.customerId).to.eql(id));",
                  "});",
                  "pm.environment.set(\"fromAccountId\", accounts[0].id);",
                  "pm.environment.set(\"toAccountId\", accounts[1].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}",
                "accounts"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Get account by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const accountSchema = {",
                  "  type: \"object\",",
